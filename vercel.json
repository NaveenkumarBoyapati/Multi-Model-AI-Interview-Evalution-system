{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": null,
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Credentials", "value": "true" },
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET,OPTIONS,PATCH,DELETE,POST,PUT" },
        { "key": "Access-Control-Allow-Headers", "value": "X-CSRF-Token, X-Requested-With, Accept, Accept-Version, Content-Length, Content-MD5, Content-Type, Date, X-Api-Version, Authorization" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/app/:path*",
      "destination": "/:path*"
    },
    {
      "source": "/api/:path*",
      "destination": "https://ai-interview-backend-new-2ccj.onrender.com/api/:path*"
    },
    {
      "source": "/interview/:path*",
      "destination": "https://ai-interview-backend-new-2ccj.onrender.com/interview/:path*"
    },
    {
      "source": "/uploads/:path*",
      "destination": "https://ai-interview-backend-new-2ccj.onrender.com/uploads/:path*"
    },
    {
      "source": "/health",
      "destination": "https://ai-interview-backend-new-2ccj.onrender.com/health"
    }
  ]
}
