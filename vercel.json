{
  "version": 2,
  "rewrites": [
    {
      "source": "/app/:path*",
      "destination": "/:path*"
    },
    {
      "source": "/api/:path*",
      "destination": "https://YOUR-BACKEND.onrender.com/api/:path*"
    },
    {
      "source": "/interview/:path*",
      "destination": "https://YOUR-BACKEND.onrender.com/interview/:path*"
    },
    {
      "source": "/uploads/:path*",
      "destination": "https://YOUR-BACKEND.onrender.com/uploads/:path*"
    },
    {
      "source": "/health",
      "destination": "https://YOUR-BACKEND.onrender.com/health"
    }
  ]
}
