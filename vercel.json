{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://YOUR-BACKEND-URL.hf.space/api/:path*"
    },
    {
      "source": "/interview/:path*",
      "destination": "https://YOUR-BACKEND-URL.hf.space/interview/:path*"
    },
    {
      "source": "/uploads/:path*",
      "destination": "https://YOUR-BACKEND-URL.hf.space/uploads/:path*"
    },
    {
      "source": "/health",
      "destination": "https://YOUR-BACKEND-URL.hf.space/health"
    }
  ]
}
