# ====================================================================
# AI Interview Evaluation System - Environment Configuration Template
# Production Stack: Vercel (Frontend) + Render (Backend) + Groq + Neon + Cloudflare R2
# ====================================================================

# --------------------------------------------------------------------
# Application Settings
# --------------------------------------------------------------------
# Base public URL of the application
# - For Local testing: http://localhost:8000
# - For Render Backend: https://<your-service>.onrender.com
# - For Vercel Frontend: https://<your-app>.vercel.app
APP_BASE_URL=http://localhost:8000
ENV=production

# --------------------------------------------------------------------
# 1. Neon Serverless PostgreSQL Database Settings (Recommended)
# --------------------------------------------------------------------
# Paste your Neon Connection URI here (starts with postgresql://):
DATABASE_URL=postgresql://neondb_owner:your_password@ep-cool-fog-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
DB_ENGINE=postgres

# Alternative: Zero-dependency local SQLite (default fallback)
# DB_ENGINE=sqlite

# Alternative: Azure SQL / Microsoft SQL Server
# DB_ENGINE=mssql
# DB_SERVER=your-server-name.database.windows.net
# DB_NAME=AIInterviewDB
# DB_USER=your_sql_admin
# DB_PASSWORD=YourStrongPassword123!
# DB_DRIVER={ODBC Driver 18 for SQL Server}

# --------------------------------------------------------------------
# 2. Groq Cloud Speech-to-Text API (Recommended for Render 512MB RAM)
# --------------------------------------------------------------------
# Get your free key at: https://console.groq.com/keys
# Keeps backend RAM under 50MB and transcribes audio in ~0.5 seconds!
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_WHISPER_MODEL=whisper-large-v3-turbo

# Local Faster-Whisper Fallback (used only if GROQ_API_KEY is empty)
# Options: tiny.en, base.en, small.en
WHISPER_MODEL_SIZE=tiny.en
WHISPER_LANGUAGE=en

# --------------------------------------------------------------------
# 3. Amazon Web Services (AWS) S3 Persistent Storage (WebM Recordings & PDFs)
# --------------------------------------------------------------------
# Preserves interview recordings across Render container restarts and redeployments.
# Generates secure, short-lived presigned PUT URLs for direct browser uploads.
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=ap-south-1
S3_BUCKET_NAME=ai-interview-recordings-nb2026

# Backward compatibility alias for Cloudflare R2 (optional fallback)
# R2_ACCOUNT_ID=your_cloudflare_account_id
# R2_ACCESS_KEY_ID=your_r2_access_key_id
# R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
# R2_BUCKET_NAME=ai-interview-recordings

# --------------------------------------------------------------------
# 4. AI Answer Evaluation Provider (Optional)
# --------------------------------------------------------------------
# Default is 'local' (offline semantic & concept matching algorithm)
AI_EVALUATION_PROVIDER=local
AI_EVALUATION_API_KEY=
AI_EVALUATION_MODEL=
AI_EVALUATION_BASE_URL=

# --------------------------------------------------------------------
# 5. Email Delivery Configuration (Password Reset & Notifications)
# --------------------------------------------------------------------
# RECOMMENDED FOR RENDER & CLOUD DEPLOYMENTS: Brevo REST API (HTTPS Port 443)
# Note: Cloud platforms (such as Render) block outbound SMTP ports 587 and 465.
# Using Brevo's HTTPS REST API bypasses all egress port blocks with zero latency.
#
# How to get your Brevo REST API Key:
# 1. Log in to your Brevo account at https://app.brevo.com
# 2. Go to: Top-right account menu -> "SMTP & API"
# 3. Click the "API Keys" tab (NOT the SMTP tab!)
# 4. Click "Generate a new API key", name it "Render-Backend", and copy it.
#    (Valid REST API keys start with 'xkeysib-'. Do NOT use 'xsmtpsib-' SMTP keys here!).
# 5. Verify your sender email at: Brevo Dashboard -> "Senders & IP" -> "Senders".
# 6. Configure these in Render Dashboard -> Environment:
BREVO_API_KEY=xkeysib-your_brevo_v3_api_key_here
SMTP_FROM_EMAIL=your_verified_brevo_sender_email@domain.com
SMTP_FROM_NAME=AI Interview Evaluation System

# OPTIONAL: Brevo SMTP Relay (Used for local environments or unblocked networks)
# Note: SMTP keys start with 'xsmtpsib-' and are generated on the "SMTP" tab.
# They are ONLY used for SMTP authentication, NEVER as the Brevo REST API key.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USER=your_brevo_account_email@domain.com
SMTP_PASSWORD=xsmtpsib-your_brevo_smtp_master_key

# OPTIONAL: Google Gmail SMTP Relay (Alternative)
# 1. Enable 2-Step Verification on your Google Account
# 2. Generate a 16-character App Password at: https://myaccount.google.com/apppasswords
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USE_TLS=true
# SMTP_USER=your_email@gmail.com
# SMTP_PASSWORD=your_16_char_app_password
# SMTP_FROM_EMAIL=your_email@gmail.com
