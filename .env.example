# ====================================================================
# AI Interview Evaluation System - Environment Configuration Template
# Copy this file to .env and fill in your production values.
# ====================================================================

# --------------------------------------------------------------------
# Application Settings
# --------------------------------------------------------------------
# Base URL where the frontend and backend are publicly accessible
# Base URL where the frontend and backend are publicly accessible
# - For local development: http://localhost:8000 or http://127.0.0.1:8000
# - For Cloudflare Tunnel testing: https://<your-subdomain>.trycloudflare.com
# NOTE: The server also dynamically inspects Origin, Referer, and X-Forwarded-Host from incoming tunnel requests,
# so password reset links sent to mobile devices will automatically use the active public HTTPS domain.
APP_BASE_URL=http://localhost:8000
ENV=production

# --------------------------------------------------------------------
# Database Settings (Microsoft SQL Server / Azure SQL / AWS RDS)
# --------------------------------------------------------------------
# Local Windows development (Windows Authentication):
# DB_SERVER=localhost
# DB_TRUSTED_CONNECTION=yes

# Azure SQL Database (Recommended Free Production Option):
# DB_SERVER=your-server-name.database.windows.net
# DB_NAME=AIInterviewDB
# DB_USER=your_sql_admin
# DB_PASSWORD=YourStrongPassword123!
# DB_DRIVER={ODBC Driver 18 for SQL Server}
# DB_ENCRYPT=yes
# DB_TRUST_SERVER_CERTIFICATE=no
# DB_TIMEOUT=60   # Recommended 60s for Azure SQL Serverless auto-pause resume


# --------------------------------------------------------------------
# Whisper Speech Recognition Model
# --------------------------------------------------------------------
# Options: tiny.en, base.en, small.en, medium.en, large-v3
# 'small.en' is recommended for high accuracy on interview speech, technical vocabulary, and diverse accents.
WHISPER_MODEL_SIZE=small.en
WHISPER_LANGUAGE=en

# --------------------------------------------------------------------
# AI Answer Evaluation Provider (Optional)
# --------------------------------------------------------------------
# Default is 'local' (concept & semantic matching algorithm)
AI_EVALUATION_PROVIDER=local
AI_EVALUATION_API_KEY=
AI_EVALUATION_MODEL=
AI_EVALUATION_BASE_URL=

# --------------------------------------------------------------------
# SMTP Mail Server Configuration (For Password Reset Emails)
# --------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_16_char_app_password
SMTP_FROM_EMAIL=your_email@gmail.com
